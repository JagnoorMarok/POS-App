<UserControl x:Class="RestaurantManagement.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:RestaurantManagement.Desktop.ViewModels"
             xmlns:dto="clr-namespace:RestaurantManagement.Application.Reports.DTOs;assembly=RestaurantManagement.Application"
             xmlns:converters="clr-namespace:RestaurantManagement.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>

        <!-- Palette -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4F46E5"/>

        <!-- Period Chip Button Style -->
        <Style x:Key="PeriodChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F8FAFC" Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <!-- 0: Header & Period Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Error Banner -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Executive KPI Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Analytics Breakdown & Top Dishes -->
                <RowDefinition Height="Auto"/>
                <!-- 4: Daily Sales History -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: HEADER & PERIOD FILTER ================= -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Title & Refresh -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📈 Sales Analytics &amp; Reports" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding PeriodLabel, StringFormat='Financial overview for {0}'}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Compile Report" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>

                    <!-- Bottom Bar: Period Selector Chips -->
                    <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Period:" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Today" Style="{StaticResource PeriodChipStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="Today" Margin="0,0,6,4"/>
                        <Button Content="Yesterday" Style="{StaticResource PeriodChipStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="Yesterday" Margin="0,0,6,4"/>
                        <Button Content="Last 7 Days" Style="{StaticResource PeriodChipStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="Last7Days" Margin="0,0,6,4"/>
                        <Button Content="This Month" Style="{StaticResource PeriodChipStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisMonth" Margin="0,0,6,4"/>
                        <Button Content="All Time" Style="{StaticResource PeriodChipStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="AllTime" Margin="0,0,6,4"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ================= ROW 1: ERROR BANNER ================= -->
            <Border Grid.Row="1" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontWeight="SemiBold" FontSize="13"/>
            </Border>

            <!-- ================= ROW 2: EXECUTIVE KPI CARDS ================= -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Net Revenue -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="NET REVENUE" FontSize="11" FontWeight="Bold" Foreground="#4F46E5"/>
                        <TextBlock Text="{Binding NetRevenue, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#4F46E5" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding GrossSales, StringFormat='Gross: ₹{0:N2}'}" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Total Settled / Paid -->
                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="COLLECTED / PAID" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                        <TextBlock Text="{Binding TotalPaidAmount, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding TotalOutstanding, StringFormat='Unpaid: ₹{0:N2}'}" FontSize="11" Foreground="#D97706"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Orders Volume -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL ORDERS" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding TotalOrders}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CompletedOrdersCount, StringFormat='{}{0} Completed'}" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Average Order Value -->
                <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="AVG ORDER VALUE" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding AverageOrderValue, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        <TextBlock Text="Per settled ticket" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- KPI 5: Tax & Discount -->
                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="TAX &amp; DISCOUNTS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalTaxes, StringFormat='Tax: ₹{0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding TotalDiscounts, StringFormat='Discount: -₹{0:N2}'}" FontSize="11" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= ROW 3: PAYMENT BREAKDOWN & TOP DISHES ================= -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <!-- Left: Payment Methods & Order Types -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Top Selling Products -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Payment Methods & Order Types -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <!-- Payment Methods Distribution -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Payment Methods Breakdown" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding PaymentMethodBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dto:PaymentMethodSalesDto}">
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding MethodName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding TransactionCount, StringFormat='{}{0} transactions'}" FontSize="11" Foreground="#94A3B8"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" FontSize="12" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Order Types Distribution -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Order Channels Distribution" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding OrderTypeBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dto:OrderTypeSalesDto}">
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding TypeName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding OrderCount, StringFormat='{}{0} orders'}" FontSize="11" Foreground="#94A3B8"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" FontSize="12" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: Top 10 Selling Products -->
                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Top Selling Menu Items" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ITEM NAME" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="QTY SOLD" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="TOTAL SALES" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding TopSellingProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dto:TopSellingProductDto}">
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QuantitySold}" FontSize="13" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalRevenue, StringFormat='₹{0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= ROW 4: DAILY SALES BREAKDOWN ================= -->
            <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="Daily Sales History" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding DailyTrend}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dto:DailySalesPointDto}">
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DateLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OrderCount, StringFormat='{}{0} orders'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Revenue, StringFormat='₹{0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
