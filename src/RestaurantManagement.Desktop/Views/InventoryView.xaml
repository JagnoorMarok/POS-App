<UserControl x:Class="RestaurantManagement.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:RestaurantManagement.Desktop.ViewModels"
             xmlns:converters="clr-namespace:RestaurantManagement.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>

        <!-- Palette -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentLight" Color="#EEF2FF"/>

        <!-- Chip Button Style -->
        <Style x:Key="FilterChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <!-- 0: Header & KPI Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Message Banners -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Filter Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Inventory Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: HEADER & KPI SUMMARY ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="📦 Stock &amp; Inventory Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Track product stock levels, set low-stock alert thresholds, and log stock adjustments." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Refresh Button -->
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh Stock" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ================= ROW 0b: KPI CARDS ================= -->
        <!-- Placed below header in a sub-grid -->
        <Grid Grid.Row="0" Margin="0,56,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Catalog Items -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOTAL PRODUCTS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalItems}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                    <TextBlock Text="Menu items in catalog" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 2: In Stock -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="HEALTHY STOCK" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                    <TextBlock Text="{Binding InStockCount}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                    <TextBlock Text="Above low-stock alert" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Low Stock Alerts -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="LOW STOCK ALERTS" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock Text="{Binding LowStockCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                    <TextBlock Text="Below threshold level" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Out of Stock -->
            <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="OUT OF STOCK" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock Text="{Binding OutOfStockCount}" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                    <TextBlock Text="Hidden from POS ordering" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= ROW 1: ALERT BANNERS ================= -->
        <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <!-- Success Banner -->
            <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" FontWeight="SemiBold" FontSize="13"/>
            </Border>

            <!-- Error Banner -->
            <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <!-- ================= ROW 2: SEARCH & FILTER TOOLBAR ================= -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Box -->
                    <ColumnDefinition Width="260"/>
                    <!-- Status Filter Chips -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,6" FontSize="13" BorderBrush="#CBD5E1" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <!-- Status Filter Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="All Items" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,6,0"/>
                    <Button Content="In Stock" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="InStock" Margin="0,0,6,0"/>
                    <Button Content="⚠️ Low Stock" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="LowStock" Margin="0,0,6,0"/>
                    <Button Content="⛔ Out of Stock" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="OutOfStock"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 3: MAIN INVENTORY LIST & DETAIL PANEL ================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Inventory Data Table -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="0" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InventoryItems}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <StackPanel>
                                    <!-- Table Header -->
                                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="PRODUCT NAME" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="2" Text="PRICE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="3" Text="STOCK LEVEL" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="5" Text="ACTION" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <ItemsPresenter/>
                                </StackPanel>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:InventoryItemViewModel}">
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,12" Background="#FFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Product Name -->
                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                        <!-- Category -->
                                        <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                                        <!-- Price -->
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedPrice}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                        <!-- Stock Units -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentStock}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text=" units" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="4" Background="{Binding StatusBadgeBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StockStatus}" Foreground="{Binding StatusBadgeColor}" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Action Button -->
                                        <Button Grid.Column="5" Content="Adjust" Background="#EEF2FF" Foreground="#4F46E5" BorderThickness="1" BorderBrush="#C7D2FE"
                                                Padding="10,4" FontSize="12" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right"
                                                Command="{Binding DataContext.OpenAdjustDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Right: Stock Adjustment & Restock Flyout -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <TextBlock Grid.Row="0" Text="Stock Adjustment Terminal" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                    <!-- Content when an item is selected -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Selected Product Info Card -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="SELECTED PRODUCT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedItem.ProductName, FallbackValue='Select an item to adjust'}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedItem.CategoryName, FallbackValue='-'}" FontSize="12" Foreground="#64748B"/>
                                    
                                    <Separator Background="#E2E8F0" Margin="0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Current Stock" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding SelectedItem.CurrentStock, FallbackValue='0'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Alert Threshold" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding SelectedItem.LowStockThreshold, FallbackValue='10'}" FontSize="18" FontWeight="Bold" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Quick Restock Chips -->
                            <TextBlock Text="QUICK RESTOCK" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <Button Content="+10" Command="{Binding QuickRestockCommand}" CommandParameter="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipStyle}">
                                            <Setter Property="Margin" Value="0,0,4,0"/>
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Setter Property="Foreground" Value="#166534"/>
                                            <Setter Property="BorderBrush" Value="#86EFAC"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="+25" Command="{Binding QuickRestockCommand}" CommandParameter="25">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipStyle}">
                                            <Setter Property="Margin" Value="2,0,2,0"/>
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Setter Property="Foreground" Value="#166534"/>
                                            <Setter Property="BorderBrush" Value="#86EFAC"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="+50" Command="{Binding QuickRestockCommand}" CommandParameter="50">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipStyle}">
                                            <Setter Property="Margin" Value="4,0,0,0"/>
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Setter Property="Foreground" Value="#166534"/>
                                            <Setter Property="BorderBrush" Value="#86EFAC"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <!-- Quick Spoilage/Waste Chips -->
                            <TextBlock Text="QUICK SPOILAGE / WASTE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <Button Content="-1 Unit" Command="{Binding QuickWasteCommand}" CommandParameter="1">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipStyle}">
                                            <Setter Property="Margin" Value="0,0,4,0"/>
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                            <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="-5 Units" Command="{Binding QuickWasteCommand}" CommandParameter="5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChipStyle}">
                                            <Setter Property="Margin" Value="4,0,0,0"/>
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                            <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <!-- Exact Count Set -->
                            <TextBlock Text="SET EXACT INVENTORY COUNT" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewExactStock, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" FontSize="13" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Save Count" Command="{Binding SaveExactStockCommand}"
                                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Reason Input -->
                            <TextBlock Text="Reason / Note" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
