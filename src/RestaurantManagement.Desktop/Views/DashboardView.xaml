<UserControl x:Class="RestaurantManagement.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:RestaurantManagement.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="950">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="DbPillBg" Color="#E0E7FF"/>
        <SolidColorBrush x:Key="DbPillFg" Color="#3730A3"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" HorizontalAlignment="Left" Margin="0,0,16,24">
            <!-- View Header Card -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="12" 
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                    Padding="24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="System Dashboard &amp; Overview" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Local SQLite Database, Menu Services, Table Management, POS Terminal &amp; Kitchen Display System" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource DbPillBg}" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DatabaseStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DbPillFg}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Operational Live Metrics Summary -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="12" 
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                    Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Live Operations &amp; Kitchen Status" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>
                    
                    <UniformGrid Columns="3" Margin="0,4">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="🍳 Total Kitchen Queue" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding KitchenActiveCount}" FontSize="28" FontWeight="Black" Foreground="#4F46E5" Margin="0,6,0,0"/>
                                <TextBlock Text="Active tickets in KDS" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="👨‍🍳 In Preparation" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding KitchenPreparingCount}" FontSize="28" FontWeight="Black" Foreground="#D97706" Margin="0,6,0,0"/>
                                <TextBlock Text="Actively being cooked" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="✅ Ready for Service" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding KitchenReadyCount}" FontSize="28" FontWeight="Black" Foreground="#059669" Margin="0,6,0,0"/>
                                <TextBlock Text="Waiting for table dispatch" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Milestone Status Card -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="12" 
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                    Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Milestone 6: Kitchen Workflow &amp; Kitchen Display System (KDS) Active" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                    <TextBlock Text="Real-time kitchen order processing, status progression (Confirmed → Preparing → Ready → Served), live age tracking, and role-based staff authorization are fully operational."
                               FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                    <!-- Feature Grid -->
                    <UniformGrid Columns="2" Margin="0,4">
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="🍳 Kitchen Display System (KDS)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="High-visibility ticket queue with item notes, order types, elapsed timers, and fast status transitions." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🛡️ Financial &amp; Data Isolation" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Kitchen staff receives historical item snapshots without access to billing modifications or price changes." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="🛒 Point-of-Sale Order Terminal" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Iterative order setup (Dine-In/Takeaway/Delivery), live category browsing, and table occupancy management." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="8,8,0,0">
                            <StackPanel>
                                <TextBlock Text="👥 Role-Based Authorization" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Fine-grained feature boundaries for Administrator, Manager, Cashier, and KitchenStaff." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- System Status Summary -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="12" 
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Active System Subsystems" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IKitchenService" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="Kitchen ticket queues, status transitions, and real-time display synchronization" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="✓ Active" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderLight}" Margin="0,6"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IOrderService" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="POS order lifecycle, item snapshots, and table occupancy tracking" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="✓ Active" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderLight}" Margin="0,6"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IAuthenticationService" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="Offline credential verification and session lifecycle" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="✓ Active" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderLight}" Margin="0,6"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IEmployeeService" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="Employee account management, role assignment, and password resets" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="✓ Active" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderLight}" Margin="0,6"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ICategoryService" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="Category querying, creation, updating, and soft deactivation" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="✓ Active" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderLight}" Margin="0,6"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IProductService" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="Product catalog, availability control, and price snapshot rules" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="✓ Active" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderLight}" Margin="0,6"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITableService" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="Table seating capacity, occupancy state, and layout management" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="✓ Active" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderLight}" Margin="0,6"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ASP.NET Core API /health" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="Shared SQLite database health endpoint operational" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="✓ Healthy" FontWeight="SemiBold" FontSize="12" Foreground="#16A34A"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
