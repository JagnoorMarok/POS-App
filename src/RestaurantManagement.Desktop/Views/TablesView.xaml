<UserControl x:Class="RestaurantManagement.Desktop.Views.TablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dto="clr-namespace:RestaurantManagement.Application.Tables.DTOs;assembly=RestaurantManagement.Application"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="OccupiedColor" Color="#EA580C"/>
        <SolidColorBrush x:Key="AvailableColor" Color="#16A34A"/>
    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" 
                BorderThickness="1" CornerRadius="12" Padding="24">
            <DockPanel>
                <!-- Top Header & Metrics Bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Summary -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Table Management" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding TotalTablesCount, StringFormat='Total: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding FreeTablesCount, StringFormat='Free: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding OccupiedTablesCount, StringFormat='Occupied: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#EA580C"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Content="All Tables" Command="{Binding SetFilterModeCommand}" CommandParameter="All"
                                Padding="10,6" Margin="0,0,4,0" FontSize="12" FontWeight="SemiBold"
                                Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Content="Free Only" Command="{Binding SetFilterModeCommand}" CommandParameter="Free"
                                Padding="10,6" Margin="0,0,4,0" FontSize="12" FontWeight="SemiBold"
                                Background="#DCFCE7" Foreground="#166534" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Content="Occupied" Command="{Binding SetFilterModeCommand}" CommandParameter="Occupied"
                                Padding="10,6" FontSize="12" FontWeight="SemiBold"
                                Background="#FFEDD5" Foreground="#9A3412" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Add Table Button -->
                    <Button Grid.Column="2" Command="{Binding OpenAddTableCommand}"
                            Background="{StaticResource AccentColor}" Foreground="White"
                            Padding="16,8" FontWeight="SemiBold" FontSize="13"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="+ Add Table"/>
                    </Button>
                </Grid>

                <!-- Tables Cards Layout -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredTables}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dto:RestaurantTableDto}">
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                        CornerRadius="12" Padding="18" Margin="0,0,16,16" Width="220">
                                    <StackPanel>
                                        <!-- Top Row: Table Number & Status Pill -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TableNumber}" FontWeight="Bold" FontSize="20" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Capacity, StringFormat='👤 {0} Seats'}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                <Setter Property="Background" Value="#FFEDD5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="FREE"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                    <Setter Property="Text" Value="OCCUPIED"/>
                                                                    <Setter Property="Foreground" Value="#C2410C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="INACTIVE"/>
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <!-- Quick Toggle Occupancy Button -->
                                        <Button Margin="0,0,0,8" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                                                Command="{Binding DataContext.ToggleOccupancyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand" BorderThickness="0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="Seat Table"/>
                                                    <Setter Property="Background" Value="#EEF2FF"/>
                                                    <Setter Property="Foreground" Value="#4F46E5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                            <Setter Property="Content" Value="Clear Table"/>
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Edit, Deactivate & Delete Controls -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="Edit" Margin="0,0,4,0" Padding="6,4" FontSize="11"
                                                    Command="{Binding DataContext.OpenEditTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>

                                            <Button Grid.Column="1" Margin="2,0,4,0" Padding="6,4" FontSize="11"
                                                    Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="Deactivate"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Content" Value="Activate"/>
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Grid.Column="2" Content="🗑️" ToolTip="Delete Table" Padding="6,4" FontSize="11"
                                                    Command="{Binding DataContext.DeleteTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= MODAL: ADD / EDIT TABLE ================= -->
        <Grid Background="#70000000" Visibility="{Binding IsTableFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding TableFormTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                    <!-- Validation Error -->
                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding TableFormError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TableFormError}" FontSize="12" Foreground="#991B1B" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Table Number (e.g. T1, Table 5) *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TableFormNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="Seating Capacity *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TableFormCapacity, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="Display Order" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TableFormDisplayOrder, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,20" FontSize="13"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="🗑️ Delete" Command="{Binding DeleteTableCommand}"
                                Background="#FEE2E2" Foreground="#DC2626" Padding="12,8" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelTableFormCommand}"
                                    Background="#F1F5F9" Foreground="#334155" Padding="14,8" Margin="0,0,8,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Save Table" Command="{Binding SaveTableCommand}"
                                    Background="{StaticResource AccentColor}" Foreground="White" Padding="16,8"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
