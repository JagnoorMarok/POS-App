<UserControl x:Class="RestaurantManagement.Desktop.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dto="clr-namespace:RestaurantManagement.Application.Billing.DTOs;assembly=RestaurantManagement.Application"
             xmlns:viewmodels="clr-namespace:RestaurantManagement.Desktop.ViewModels"
             xmlns:converters="clr-namespace:RestaurantManagement.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>

        <!-- Palette -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentLight" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#16A34A"/>
        <SolidColorBrush x:Key="WarningColor" Color="#D97706"/>
        <SolidColorBrush x:Key="DangerColor" Color="#DC2626"/>

        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettleCompleteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <!-- Top Alert Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Notification Banner -->
        <StackPanel Grid.Row="0">
            <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="20,12,20,0"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#15803D" FontWeight="SemiBold" FontSize="13"/>
            </Border>
            <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="20,12,20,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <!-- Main 3-Column Layout -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <!-- Left: Orders Awaiting Billing (320px) -->
                <ColumnDefinition Width="320"/>
                <!-- Center: Bill Receipt Details (*) -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Payment & Settlement Panel (360px) -->
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: ORDERS LIST ================= -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Active Orders" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="🔄" Width="28" Height="28" Style="{StaticResource ChipBtnStyle}" Command="{Binding RefreshOrdersCommand}" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Order Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OrdersAwaitingBilling}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:BillingOrderSummaryItemViewModel}">
                                    <Button Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,0,10" Padding="12" HorizontalContentAlignment="Stretch"
                                            BorderThickness="1" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#EEF2FF"/>
                                                        <Setter Property="BorderBrush" Value="#4F46E5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TableOrTypeBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}"/>
                                            </Grid>

                                            <!-- Status & Item Count -->
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StatusBadge}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat='{}{0} items'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>

                                            <!-- Financials -->
                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TotalAmount, StringFormat='Total: ₹{0:N2}'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                                
                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding RemainingAmount, StringFormat='DUE: ₹{0:N0}'}"/>
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                                                        <Setter Property="Text" Value="PAID"/>
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= CENTER: BILL DETAILS ================= -->
            <Border Grid.Column="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,0">
                <Grid>
                    <!-- Case 1: No Order Selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoSelectedBill, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🧾" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Select an Order to View Bill" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click on any active order from the left pane to view breakdown and record payments." FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Case 2: Order Selected Bill Display -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelectedBill, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Restaurant Branding Header -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding CurrentBill.RestaurantName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding CurrentBill.RestaurantAddress}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CurrentBill.TaxNumber, StringFormat='GST / Tax ID: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CurrentBill.OrderNumber}" FontSize="16" FontWeight="Black" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding CurrentBill.OrderType, StringFormat='Type: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CurrentBill.TableNumber, StringFormat='Table: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CurrentBill.CreatedAt, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Line Items Header -->
                            <Border Background="#F1F5F9" Padding="12,8" CornerRadius="6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ITEM DESCRIPTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="QTY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="PRICE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Line Items List -->
                            <ItemsControl ItemsSource="{Binding CurrentBill.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dto:BillItemDto}">
                                        <Border Padding="12,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding Notes, StringFormat='Note: {0}'}" FontSize="10" Foreground="#B45309" Visibility="{Binding Notes, Converter={StaticResource StringToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='₹{0:N2}'}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Financial Breakdown Summary -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Subtotal:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding CurrentBill.Subtotal, StringFormat='₹{0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Discount Row with Editor -->
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Discount:" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Width="60" Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="4,2" VerticalAlignment="Center"/>
                                            <Button Content="Apply" Style="{StaticResource ChipBtnStyle}" Command="{Binding ApplyDiscountCommand}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CurrentBill.DiscountAmount, StringFormat='- ₹{0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Tax (GST):" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding CurrentBill.TaxAmount, StringFormat='₹{0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Separator Background="{StaticResource BorderLight}" Margin="0,4,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="GRAND TOTAL:" FontSize="16" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding CurrentBill.TotalAmount, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Black" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Total Paid:" FontSize="13" Foreground="{StaticResource SuccessColor}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentBill.PaidAmount, StringFormat='₹{0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessColor}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Remaining Balance:" FontSize="14" FontWeight="Bold" Foreground="#B45309"/>
                                        <TextBlock Text="{Binding CurrentBill.RemainingAmount, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Black" Foreground="#B45309" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Payment History -->
                            <TextBlock Text="Payment Transactions" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding CurrentBill.Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dto:PaymentDto}">
                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PaymentMethod}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:hh:mm:ss tt}'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='₹{0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SuccessColor}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= RIGHT: PAYMENT & SETTLEMENT ================= -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Payment Terminal" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Due Badge -->
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="OUTSTANDING DUE" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding CurrentBill.RemainingAmount, StringFormat='₹{0:N2}', FallbackValue='₹0.00'}" FontSize="24" FontWeight="Black" Foreground="#B45309" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Payment Method Picker -->
                            <TextBlock Text="Payment Method" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding AvailablePaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" Padding="10,8" Margin="0,0,0,14"/>

                            <!-- Amount To Pay -->
                            <TextBlock Text="Amount to Pay (₹)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <TextBox Text="{Binding PaymentAmountInput, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" FontWeight="Bold"/>
                                <Button Content="Exact" Style="{StaticResource ChipBtnStyle}" Command="{Binding FillExactRemainingCommand}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                            </Grid>

                            <!-- Cash Tendered & Change Calculation (Shown when Cash selected) -->
                            <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Cash Received / Tendered (₹)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CashTenderedInput, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                                <!-- Quick Tender Chips -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="₹500" Style="{StaticResource ChipBtnStyle}" Command="{Binding SetQuickTenderCommand}" CommandParameter="500"/>
                                    <Button Content="₹1000" Style="{StaticResource ChipBtnStyle}" Command="{Binding SetQuickTenderCommand}" CommandParameter="1000"/>
                                    <Button Content="₹2000" Style="{StaticResource ChipBtnStyle}" Command="{Binding SetQuickTenderCommand}" CommandParameter="2000"/>
                                </StackPanel>

                                <!-- Change to Return Box -->
                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <Grid>
                                        <TextBlock Text="Change to Return:" FontSize="12" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CalculatedChange, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Black" Foreground="#15803D" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Transaction Reference -->
                            <TextBlock Text="Transaction Reference / Note" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding TransactionReferenceInput, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="12" Margin="0,0,0,16"/>

                            <!-- Record Payment Button -->
                            <Button Content="💵 Record Payment" Style="{StaticResource PrimaryActionBtnStyle}" Command="{Binding RecordPaymentCommand}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settlement Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <Button Content="🎉 Complete &amp; Settle Order" Style="{StaticResource SettleCompleteBtnStyle}" Command="{Binding SettleOrderCommand}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
