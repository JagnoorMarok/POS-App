<UserControl x:Class="RestaurantManagement.Desktop.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dto="clr-namespace:RestaurantManagement.Application.Menu.DTOs;assembly=RestaurantManagement.Application"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentHover" Color="#4338CA"/>
        <SolidColorBrush x:Key="DangerColor" Color="#DC2626"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#16A34A"/>
    </UserControl.Resources>

    <Grid>
        <!-- Main Two-Column Layout -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Category Panel -->
                <ColumnDefinition Width="300"/>
                <!-- Product Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: CATEGORY PANEL ================= -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" 
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,16,0" Padding="16">
                <DockPanel>
                    <!-- Category Header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Categories" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Menu groups" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding OpenAddCategoryCommand}"
                                Background="{StaticResource AccentColor}" Foreground="White"
                                Padding="12,6" FontWeight="SemiBold" FontSize="12"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="+ Add Category"/>
                        </Button>
                    </Grid>

                    <!-- "All Categories" Button -->
                    <Button DockPanel.Dock="Top" Command="{Binding ClearCategoryFilterCommand}"
                            Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            Padding="12,8" Margin="0,0,0,10" HorizontalContentAlignment="Left" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="All Categories" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Grid.Column="1" Text="Show All" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </Button>

                    <!-- Categories List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dto:CategoryDto}">
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Name & Count -->
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding ProductCount, StringFormat={}{0} items}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Active Status Badge -->
                                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Active"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="Inactive"/>
                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Category Action Buttons -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                                <!-- Filter Button -->
                                                <Button Content="Filter" Margin="0,0,4,0" Padding="6,3" FontSize="11"
                                                        Command="{Binding DataContext.ClearCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#EEF2FF" Foreground="#4F46E5" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>

                                                <!-- Edit Button -->
                                                <Button Content="Edit" Margin="0,0,4,0" Padding="6,3" FontSize="11"
                                                        Command="{Binding DataContext.OpenEditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>

                                                <!-- Activate/Deactivate Button -->
                                                <Button Margin="0,0,4,0" Padding="6,3" FontSize="11"
                                                        Command="{Binding DataContext.ToggleCategoryActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content" Value="Deactivate"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Content" Value="Activate"/>
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Delete Category Button -->
                                                <Button Content="🗑️" ToolTip="Delete Category" Margin="0,0,0,0" Padding="6,3" FontSize="11"
                                                        Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= RIGHT: PRODUCT PANEL ================= -->
            <Border Grid.Column="1" Background="{StaticResource CardBackground}" 
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                    CornerRadius="12" Padding="20">
                <DockPanel>
                    <!-- Product Header & Search/Add Toolbar -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Bar -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Add Product Button -->
                        <Button Grid.Column="2" Command="{Binding OpenAddProductCommand}"
                                Background="{StaticResource AccentColor}" Foreground="White"
                                Padding="14,8" FontWeight="SemiBold" FontSize="13"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="+ Add Product"/>
                        </Button>
                    </Grid>

                    <!-- Product List (Table/Grid) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dto:ProductDto}">
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                            CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Product Details -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Category Badge -->
                                                <ColumnDefinition Width="130"/>
                                                <!-- Price -->
                                                <ColumnDefinition Width="100"/>
                                                <!-- Availability -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- Actions -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: Product Info -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Col 1: Category Tag -->
                                            <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="6" Padding="8,4" 
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="Medium" Foreground="#4F46E5"/>
                                            </Border>

                                            <!-- Col 2: Price -->
                                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='₹{0:N2}'}" 
                                                       FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center"/>

                                            <!-- Col 3: Stock Status Badge -->
                                            <Border Grid.Column="3" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Available"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Text" Value="Out of Stock"/>
                                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Col 4: Action Buttons -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Toggle Availability -->
                                                <Button Margin="0,0,6,0" Padding="8,5" FontSize="11"
                                                        Command="{Binding DataContext.ToggleProductAvailabilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content" Value="Mark Out"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Content" Value="Mark Avail"/>
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Edit Product -->
                                                <Button Content="Edit" Margin="0,0,6,0" Padding="8,5" FontSize="11"
                                                        Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>

                                                <!-- Toggle Active -->
                                                <Button Margin="0,0,6,0" Padding="8,5" FontSize="11"
                                                        Command="{Binding DataContext.ToggleProductActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content" Value="Deactivate"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Content" Value="Activate"/>
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Delete Product -->
                                                <Button Content="🗑️" ToolTip="Delete Menu Item" Margin="0,0,0,0" Padding="8,5" FontSize="11"
                                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL: ADD / EDIT CATEGORY ================= -->
        <Grid Background="#70000000" Visibility="{Binding IsCategoryFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="24" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding CategoryFormTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                    <!-- Validation Error -->
                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding CategoryFormError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CategoryFormError}" FontSize="12" Foreground="#991B1B" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Category Name *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CategoryFormName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="Description" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CategoryFormDescription, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="Display Order" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CategoryFormDisplayOrder, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,20" FontSize="13"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="🗑️ Delete" Command="{Binding DeleteCategoryCommand}"
                                Background="#FEE2E2" Foreground="#DC2626" Padding="12,8" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelCategoryFormCommand}"
                                    Background="#F1F5F9" Foreground="#334155" Padding="14,8" Margin="0,0,8,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Save Category" Command="{Binding SaveCategoryCommand}"
                                    Background="{StaticResource AccentColor}" Foreground="White" Padding="16,8"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL: ADD / EDIT PRODUCT ================= -->
        <Grid Background="#70000000" Visibility="{Binding IsProductFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ProductFormTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                    <!-- Validation Error -->
                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding ProductFormError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ProductFormError}" FontSize="12" Foreground="#991B1B" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Product Name *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ProductFormName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" FontSize="13"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Price (₹) *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ProductFormPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='F2'}" Padding="8,6" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Category *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding ProductFormCategoryId}"
                                      Padding="8,6" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ProductFormDescription, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" FontSize="13"/>

                    <CheckBox Content="Product is Available for Ordering" IsChecked="{Binding ProductFormIsAvailable}" 
                              Margin="0,0,0,20" FontSize="13" FontWeight="Medium"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="🗑️ Delete" Command="{Binding DeleteProductCommand}"
                                Background="#FEE2E2" Foreground="#DC2626" Padding="12,8" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelProductFormCommand}"
                                    Background="#F1F5F9" Foreground="#334155" Padding="14,8" Margin="0,0,8,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Save Product" Command="{Binding SaveProductCommand}"
                                    Background="{StaticResource AccentColor}" Foreground="White" Padding="16,8"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
